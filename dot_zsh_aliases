gcp-pick() {
  local PROJECT_ID
  PROJECT_ID=$(gcloud projects list --format="value(projectId)" | fzf --prompt="Select GCP Project: ")
  if [[ -z "$PROJECT_ID" ]]; then
    echo "No project selected."
    return 1
  fi
  gcloud config set project "$PROJECT_ID"
  echo "Default project set to: $PROJECT_ID"
}

bw_ensure_session() {
  if [ "$(bw status | jq -r '.status')" != "unlocked" ]; then
    export BW_SESSION="$(bw unlock --raw)"
    echo "export BW_SESSION='${BW_SESSION}'" >| ~/.cache/anthropic_session
    chmod 600 ~/.cache/anthropic_session
  fi
}

bw_load_anthropic_key() {
  bw_ensure_session

  export ANTHROPIC_AUTH_TOKEN="$(
    bw get item f05fdf65-e459-4aaa-8c36-b471016fe516 \
    | jq -r '.fields[]? | select(.name=="Api Key") | .value'
  )"

  echo "export ANTHROPIC_AUTH_TOKEN='${ANTHROPIC_AUTH_TOKEN}'" >> ~/.cache/anthropic_session
}

bw_unload_anthropic_key() {
  unset BW_SESSION
  unset ANTHROPIC_AUTH_TOKEN
  rm -f ~/.cache/anthropic_session
}

# --- Zellij session pickers ---

_zs() { zellij list-sessions -s -n; }  # list session names

za() {
  local s
  s=$(_zs | fzf --prompt="Attach: " --height=~10)
  [[ -n "$s" ]] && zellij attach "$s"
}

zk() {
  local s
  s=$(_zs | fzf --prompt="Kill: " --height=~10)
  [[ -n "$s" ]] && zellij kill-session "$s"
}

zd() {
  local s
  s=$(_zs | fzf --prompt="Delete: " --height=~10)
  [[ -n "$s" ]] && zellij delete-session "$s"
}

# zellij worktree — fzf-pick a git worktree and start a session named "repo/branch"
# optionally pass a repo path: zwt ~/some-repo; defaults to current dir
zwt() {
  local repo="${1:-.}"

  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    echo "Not in a git repository."
    return 1
  fi

  local repo_name
  repo_name=$(basename "$(git -C "$repo" rev-parse --show-toplevel)")

  local selection
  selection=$(git -C "$repo" worktree list --porcelain | awk '
    BEGIN { path=""; label="" }
    /^worktree / { path=$2 }
    /^branch/    { sub(/^branch refs\/heads\//, ""); label=$2 }
    /^HEAD/      { if (!label) label="(detached)" }
    /^$/         { if (path) print path "\t" label; path=""; label="" }
    END          { if (path) print path "\t" label }
  ' | fzf --prompt="Worktree: " --height=~10 --delimiter="\t" --with-nth=2)

  if [[ -z "$selection" ]]; then
    return 0
  fi

  local wt_path wt_label
  wt_path=$(echo "$selection" | cut -f1)
  wt_label=$(echo "$selection" | cut -f2 | tr '/' '-')

  local session_name="${repo_name}/${wt_label}"

  if [[ -n "$ZELLIJ_SESSION_NAME" ]]; then
    echo "Already inside zellij. Detach first (Ctrl+o d) or use zss to switch."
    return 1
  fi

  cd "$wt_path" && zellij --session "$session_name"
}

# zellij new session — start or attach to a session named after the current directory
zns() {
  local name
  name=$(basename "$PWD")

  if [[ "$ZELLIJ_SESSION_NAME" == "$name" ]]; then
    echo "Already in session \"$name\"."
    return 0
  fi

  # inside a different zellij session — attaching would nest, which is dangerous
  if [[ -n "$ZELLIJ_SESSION_NAME" ]]; then
    echo "\"$name\" is a different session. Detach first (Ctrl+o d) or use Ctrl+o w to switch."
    return 1
  fi

  if zellij list-sessions -s -n 2>/dev/null | grep -qxF "$name"; then
    zellij attach "$name"
  else
    zellij --session "$name"
  fi
}

# zellij switch session — open the session switcher (only works inside a zellij session)
zss() {
  if [[ -z "$ZELLIJ_SESSION_NAME" ]]; then
    echo "Not inside a zellij session."
    return 1
  fi
  zellij action launch-or-focus-plugin --floating session-manager
}
