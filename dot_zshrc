# Propagate BW/Anthropic session vars across all panes
_bw_source_session() {
  [[ -f ~/.cache/anthropic_session ]] && source ~/.cache/anthropic_session

  # Warn once per shell if BW session has expired (async to avoid prompt delay)
  if [[ -z $_BW_SESSION_CHECKED && -n $BW_SESSION ]]; then
    _BW_SESSION_CHECKED=1
    (bw status | jq -r '.status' | grep -qv "unlocked" && \
      echo "⚠️  Bitwarden session expired. Run bw_load_anthropic_key to re-authenticate." >&2) &!
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _bw_source_session

